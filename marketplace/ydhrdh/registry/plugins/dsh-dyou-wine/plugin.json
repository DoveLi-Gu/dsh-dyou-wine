    "ui",
    "desktop-pet",
    "animation",
    "entertainment"
  ],
  "compatibility": {
    "dsh": "0.2.0-rc.2",
    "platforms": [
      "windows"
    ]
  },
  "install": {
    "target": "git",
    "spec": "github:DoveLi-Gu/dsh-dyou-wine#v0.1.0-alpha.14",
